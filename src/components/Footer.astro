---
interface Props {
  lang?: string;
}

const { lang } = Astro.props;

const PRODUTO = [
  { href: '/#como-funciona', label: 'Como funciona' },
  { href: '/#biblioteca', label: 'Biblioteca educativa' },
  { href: '/#assistente-ia', label: 'Assistente de IA' },
  { href: 'https://tutoriais.pragas.agrorumo.com', label: 'Tutoriais em vídeo' },
  { href: '/#downloads', label: 'Baixar' },
];
const EMPRESA = [
  { href: 'https://agrorumo.com', label: 'AgroRumo', external: true },
  { href: '/#faq', label: 'FAQ', external: false },
  { href: '/suporte', label: 'Suporte', external: false },
  { href: 'mailto:contato@agrorumo.com', label: 'Contato', external: false },
];
const LEGAL = [
  { href: '/privacidade', label: 'Privacidade' },
  { href: '/termos', label: 'Termos de uso' },
  { href: '/excluir-conta', label: 'Excluir dados do app' },
];

const year = new Date().getFullYear();
---

<footer lang={lang} class="relative bg-[var(--color-forest)] pt-16 md:pt-20 pb-10 overflow-hidden" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Rodapé Rumo Pragas</h2>

  <!-- linha de acento no topo -->
  <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-[var(--color-leaf)] via-[var(--color-lime)] to-[var(--color-amber)]" aria-hidden="true"></div>

  <div class="container-px">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-10 md:gap-12 mb-12">
      <!-- Brand -->
      <div class="flex flex-col space-y-5 sm:col-span-2 md:col-span-1">
        <div class="flex items-center gap-2.5">
          <img
            src="/app-icon-64.webp"
            width="40"
            height="40"
            alt=""
            class="h-10 w-10 rounded-xl"
            loading="lazy"
            decoding="async"
          />
          <span class="text-xl font-bold tracking-tight text-white">
            Rumo <span class="text-[var(--color-lime)]">Pragas</span>
          </span>
        </div>
        <p class="text-sm text-white/70 leading-relaxed max-w-[280px]">
          Apoio por IA para organizar hipóteses de identificação no campo, com confiança e limites claros.
        </p>
        <div class="flex items-center gap-4 pt-1">
          <a
            href="https://instagram.com/agrorumo.apps"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram AgroRumo"
            class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/15 text-white/70 hover:text-white hover:border-[var(--color-lime)]/60 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          </a>
          <a
            href="https://agrorumo.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Site AgroRumo"
            class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/15 text-white/70 hover:text-white hover:border-[var(--color-lime)]/60 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
          </a>
          <a
            href="mailto:contato@agrorumo.com"
            aria-label="Email contato"
            class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/15 text-white/70 hover:text-white hover:border-[var(--color-lime)]/60 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </a>
        </div>
      </div>

      <div class="flex flex-col space-y-4">
        <h3 class="text-[var(--color-lime)] text-xs font-bold tracking-[0.15em] uppercase">Produto</h3>
        <nav class="flex flex-col space-y-2.5" aria-label="Produto">
          {PRODUTO.map((l) => (
            <a href={l.href} class="text-[15px] text-white/70 hover:text-white w-fit transition-colors py-0.5">{l.label}</a>
          ))}
        </nav>
      </div>

      <div class="flex flex-col space-y-4">
        <h3 class="text-[var(--color-lime)] text-xs font-bold tracking-[0.15em] uppercase">Empresa</h3>
        <nav class="flex flex-col space-y-2.5" aria-label="Empresa">
          {EMPRESA.map((l) => (
            <a
              href={l.href}
              target={l.external ? '_blank' : undefined}
              rel={l.external ? 'noopener noreferrer' : undefined}
              class="text-[15px] text-white/70 hover:text-white w-fit transition-colors py-0.5"
            >{l.label}</a>
          ))}
        </nav>
      </div>

      <div class="flex flex-col space-y-4">
        <h3 class="text-[var(--color-lime)] text-xs font-bold tracking-[0.15em] uppercase">Legal</h3>
        <nav class="flex flex-col space-y-2.5" aria-label="Legal">
          {LEGAL.map((l) => (
            <a href={l.href} class="text-[15px] text-white/70 hover:text-white w-fit transition-colors py-0.5">{l.label}</a>
          ))}
        </nav>
      </div>
    </div>

    <div class="pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-5">
      <div class="text-white/55 text-[13px] text-center md:text-left leading-relaxed">
        Rumo Pragas é um produto AgroRumo · MM CAMPO FORTE LTDA · CNPJ 57.169.838/0001-20
        <br class="hidden md:block" />
        © {year} — Todos os direitos reservados.
      </div>
      <div class="flex flex-wrap justify-center gap-2.5">
        <button type="button" data-consent-settings class="px-3 py-1.5 rounded-full border border-white/20 bg-white/5 text-[11px] font-semibold text-white/85 hover:bg-white/10">
          Preferências de medição
        </button>
        <span class="px-3 py-1.5 rounded-full border border-white/15 bg-white/5 text-[11px] font-semibold text-white/80 inline-flex items-center gap-1.5">
          Feito no Brasil <span aria-hidden="true">🇧🇷</span>
        </span>
        <span class="px-3 py-1.5 rounded-full border border-white/15 bg-white/5 text-[11px] font-semibold text-white/80 inline-flex items-center gap-1.5">
          LGPD
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-lime)]" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
        </span>
        <span class="px-3 py-1.5 rounded-full border border-white/15 bg-white/5 text-[11px] font-semibold text-white/80 inline-flex items-center gap-1.5">
          Disponível nas lojas <span aria-hidden="true">🌱</span>
        </span>
      </div>
    </div>
    <p lang="en" class="mt-6 text-center text-[11px] leading-relaxed text-white/60 md:text-left">
      Apple, the Apple logo, and App Store are trademarks of Apple Inc., registered in the U.S. and other countries and regions.
      Google Play and the Google Play logo are trademarks of Google LLC.
    </p>
  </div>
</footer>
