---
// Galeria de pragas reais BR — zero JS (scroll-snap no mobile, grid no desktop).
interface Praga {
  nome: string;
  cientifico: string;
  culturas: string[];
  tipo: 'Praga' | 'Doença';
}

const PRAGAS: Praga[] = [
  { nome: 'Lagarta-do-cartucho', cientifico: 'Spodoptera frugiperda', culturas: ['Milho', 'Soja'], tipo: 'Praga' },
  { nome: 'Percevejo-marrom', cientifico: 'Euschistus heros', culturas: ['Soja'], tipo: 'Praga' },
  { nome: 'Ferrugem-asiática', cientifico: 'Phakopsora pachyrhizi', culturas: ['Soja'], tipo: 'Doença' },
  { nome: 'Bicudo-do-algodoeiro', cientifico: 'Anthonomus grandis', culturas: ['Algodão'], tipo: 'Praga' },
  { nome: 'Broca-do-café', cientifico: 'Hypothenemus hampei', culturas: ['Café'], tipo: 'Praga' },
  { nome: 'Cigarrinha-do-milho', cientifico: 'Dalbulus maidis', culturas: ['Milho'], tipo: 'Praga' },
  { nome: 'Mosca-branca', cientifico: 'Bemisia tabaci', culturas: ['Hortifrúti', 'Algodão'], tipo: 'Praga' },
];

// Ícones por tipo (paths lucide-style)
const BUG_PATH =
  'M8 2l1.88 1.88M14.12 3.88 16 2M9 7.13v-1a3.003 3.003 0 1 1 6 0v1M12 20c-3.3 0-6-2.7-6-6v-3a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v3c0 3.3-2.7 6-6 6zM12 20v-9M6.53 9C4.6 8.8 3 7.1 3 5M6 13H2M6.34 17.66 3.5 20.5M17.47 9c1.93-.2 3.53-1.9 3.53-4M22 13h-4M17.66 17.66l2.84 2.84';
const LEAF_PATH =
  'M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10zM2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12';
---

<section id="biblioteca" class="section relative bg-[var(--color-bg-soft)] overflow-hidden">
  <div class="blob-leaf w-[380px] h-[380px] -top-40 -left-40 opacity-60" aria-hidden="true"></div>
  <div class="container-px relative">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 reveal-on-scroll">
      <div class="max-w-2xl">
        <p class="eyebrow">Biblioteca educativa</p>
        <h2 class="h2-display mt-3">
          Referências para <span class="text-[var(--color-leaf-ink)]">estudar sinais no campo</span>
        </h2>
        <p class="mt-4 text-lg text-[var(--color-slate)]">
          Consulte nomes, culturas associadas e informações educativas. A presença na biblioteca não garante que toda foto será identificada.
        </p>
      </div>
      <p class="hidden md:block text-sm text-[var(--color-slate)] shrink-0 pb-1" aria-hidden="true">
        Alguns exemplos ↓
      </p>
    </div>
  </div>

  <div class="mt-10 relative">
    <ul
      class="snap-row container-px flex gap-4 overflow-x-auto pb-4 lg:grid lg:grid-cols-4 lg:overflow-visible lg:gap-5 list-none m-0"
      aria-label="Exemplos de referências da biblioteca educativa"
    >
      {PRAGAS.map((p) => (
        <li class="snap-item shrink-0 w-[240px] lg:w-auto">
          <article class="card card-hover h-full p-5">
            <div class="flex items-center justify-between">
              <span
                class:list={[
                  'flex h-11 w-11 items-center justify-center rounded-xl border',
                  p.tipo === 'Doença'
                    ? 'bg-[#FEF6E0] border-[#F4B400]/30 text-[#8A6400]'
                    : 'bg-[#EDF7E8] border-[var(--color-leaf)]/25 text-[var(--color-leaf-ink)]',
                ]}
                aria-hidden="true"
              >
                <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d={p.tipo === 'Doença' ? LEAF_PATH : BUG_PATH} />
                </svg>
              </span>
              <span
                class:list={[
                  'rounded-full px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider',
                  p.tipo === 'Doença' ? 'bg-[#FEF6E0] text-[#8A6400]' : 'bg-[#EDF7E8] text-[var(--color-leaf-ink)]',
                ]}
              >
                {p.tipo}
              </span>
            </div>
            <h3 class="mt-4 text-base font-bold leading-snug text-[var(--color-forest)]">{p.nome}</h3>
            <p class="mt-0.5 text-xs italic text-[var(--color-slate)]">{p.cientifico}</p>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {p.culturas.map((c) => (
                <span class="chip !bg-white !text-xs">{c}</span>
              ))}
            </div>
          </article>
        </li>
      ))}

      <!-- card final: e muito mais -->
      <li class="snap-item shrink-0 w-[240px] lg:w-auto">
        <div class="h-full rounded-2xl border-2 border-dashed border-[var(--color-mist)] p-5 flex flex-col items-center justify-center text-center gap-2">
          <span class="text-2xl" aria-hidden="true">🌱</span>
          <p class="text-sm font-semibold text-[var(--color-forest)]">E a biblioteca segue crescendo</p>
          <p class="text-xs text-[var(--color-slate)]">Soja, milho, café, algodão, citros, cana e hortifrúti.</p>
        </div>
      </li>
    </ul>
  </div>
</section>
