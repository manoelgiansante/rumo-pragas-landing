---
const PERSONAS = [
  {
    title: 'Produtor rural',
    desc: 'Registre um sinal, organize a suspeita e leve mais contexto para quem acompanha a área.',
    icon: 'tractor',
  },
  {
    title: 'Agrônomo & consultor',
    desc: 'Receba um registro estruturado como informação adicional à vistoria e ao diagnóstico técnico.',
    icon: 'clipboard',
  },
  {
    title: 'Cooperativa',
    desc: 'Compartilhe uma ferramenta educativa gratuita, sem criar comunidade ou expor dados entre usuários.',
    icon: 'users',
  },
  {
    title: 'Estudante de agro',
    desc: 'Consulte a biblioteca e compare hipóteses, sempre tratando a IA como apoio ao aprendizado.',
    icon: 'book',
  },
];

const ICONS: Record<string, string> = {
  tractor:
    'M3 4h9l1 7M4 11V4M8 10V4M18 5c-.6 0-1 .4-1 1v5.6M10 15h4M19 18a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM5 18a4 4 0 1 0 0 .01M22 15h-3',
  clipboard:
    'M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2M9 2h6a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1z',
  users:
    'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
  book: 'M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20',
};
---

<section id="pra-quem" class="section relative bg-[var(--color-bg-soft)]">
  <div class="container-px">
    <div class="max-w-2xl mx-auto text-center reveal-on-scroll">
      <p class="eyebrow justify-center">Pra quem é</p>
      <h2 class="h2-display mt-3">Feito pra quem vive <span class="text-[var(--color-leaf-ink)]">o campo</span></h2>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {PERSONAS.map((p) => (
        <article class="card card-hover reveal-on-scroll p-6">
          <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-[#EDF7E8] to-[#F7FAF7] border border-[var(--color-leaf)]/20 text-[var(--color-leaf-ink)]" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d={ICONS[p.icon]} />
            </svg>
          </span>
          <h3 class="mt-4 text-lg font-bold text-[var(--color-forest)]">{p.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--color-slate)]">{p.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>
