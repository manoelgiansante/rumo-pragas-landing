---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogLocale?: string;
  canonical?: string;
  noindex?: boolean;
  lang?: string;
  uiLang?: string;
  includeHomeStructuredData?: boolean;
}

const {
  title = 'Rumo Pragas — Apoio à identificação de pragas por foto',
  description = 'Envie uma foto e receba uma hipótese de identificação por IA, com nível de confiança e alternativas. Grátis para iPhone e Android. A análise requer internet.',
  ogImage = 'https://pragas.agrorumo.com/images/rumo-pragas-social.png',
  ogImageAlt = 'Rumo Pragas: hipóteses por foto, confiança, alternativas e conteúdo de manejo integrado de pragas',
  ogLocale = 'pt_BR',
  canonical = 'https://pragas.agrorumo.com',
  noindex = false,
  lang = 'pt-BR',
  uiLang = lang,
  includeHomeStructuredData = false,
} = Astro.props;

const GA4_ID = import.meta.env.PUBLIC_GA4_ID ?? '';
const META_PIXEL_ID = import.meta.env.PUBLIC_FB_PIXEL_ID ?? '';

const faqItems = [
  {
    q: 'O Rumo Pragas é gratuito?',
    a: 'Sim. O aplicativo não tem assinatura, compra interna, plano pago ou período de teste.',
  },
  {
    q: 'A identificação é definitiva?',
    a: 'Não. A IA apresenta uma hipótese probabilística, um nível de confiança e possíveis alternativas. Decisões relevantes exigem validação profissional.',
  },
  {
    q: 'Funciona no campo sem conexão?',
    a: 'A análise precisa de internet. Se o envio falhar, a solicitação pode ficar em uma fila local e ser retomada quando a rede voltar. Não há inferência offline.',
  },
  {
    q: 'O que acontece com a foto?',
    a: 'A foto é enviada ao backend e encaminhada ao provedor de análise ativo — Agrio por padrão ou o provedor alternativo indicado na Política de Privacidade. O histórico atual grava o resultado estruturado, sem escrever uma URL da foto nesse registro.',
  },
];
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0D2B1E" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonical} />

    <meta property="og:site_name" content="Rumo Pragas" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="500" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={ogLocale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Rumo Pragas" />
    <meta name="format-detection" content="telephone=no" />

    {includeHomeStructuredData && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'SoftwareApplication',
            name: 'Rumo Pragas',
            description: 'Aplicativo gratuito de apoio à identificação visual de pragas e outros sinais em lavouras. A IA apresenta uma hipótese, nível de confiança e possíveis alternativas.',
            applicationCategory: 'UtilitiesApplication',
            operatingSystem: 'Android, iOS',
            inLanguage: ['pt-BR', 'en', 'es'],
            url: 'https://pragas.agrorumo.com',
            isAccessibleForFree: true,
            offers: {
              '@type': 'Offer',
              price: '0',
              priceCurrency: 'BRL',
            },
            featureList: [
              'Hipótese de identificação por foto',
              'Nível de confiança e alternativas',
              'Fila de reenvio para conexão intermitente',
              'Biblioteca educativa',
              'Histórico estruturado',
              'Assistente de IA educativo',
            ],
            sameAs: [
              'https://apps.apple.com/br/app/rumo-pragas-ia/id6762232682',
              'https://play.google.com/store/apps/details?id=com.agrorumo.rumopragas',
            ],
          },
          {
            '@type': 'Organization',
            name: 'AgroRumo',
            legalName: 'MM CAMPO FORTE LTDA',
            taxID: '57.169.838/0001-20',
            url: 'https://agrorumo.com',
            logo: 'https://pragas.agrorumo.com/app-icon-512.png',
          },
          {
            '@type': 'WebSite',
            name: 'Rumo Pragas',
            url: 'https://pragas.agrorumo.com',
            inLanguage: 'pt-BR',
            publisher: {
              '@type': 'Organization',
              name: 'AgroRumo',
            },
          },
        ],
      })} />
    )}

    {includeHomeStructuredData && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqItems.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.a,
          },
        })),
      })} />
    )}

    <script
      is:inline
      defer
      src="/analytics-consent.js"
      data-meta-id={META_PIXEL_ID}
      data-ga-id={GA4_ID}
    ></script>
  </head>
  <body>
    <a href="#main-content" class="skip-link" lang={uiLang}>Pular para o conteúdo</a>
    <slot />

    <aside
      id="analytics-consent"
      class="consent-banner"
      aria-labelledby="analytics-consent-title"
      lang={uiLang}
      hidden
    >
      <div>
        <p id="analytics-consent-title" class="font-semibold text-[var(--color-forest)]">Medição opcional do site</p>
        <p class="mt-1 text-sm leading-relaxed text-[var(--color-slate)]">
          Com sua autorização, usamos Meta Pixel e, quando configurado, Google Analytics para medir visitas e cliques nas lojas.
          <a href="/privacidade#cookies" class="font-semibold text-[var(--color-leaf-ink)] underline underline-offset-2">Saiba mais</a>.
        </p>
      </div>
      <div class="flex shrink-0 flex-wrap gap-2">
        <button type="button" data-consent-choice="deny" class="btn-ghost !min-h-11 !px-4 text-sm">Recusar</button>
        <button type="button" data-consent-choice="accept" class="btn-primary !min-h-11 !px-4 text-sm">Aceitar medição</button>
      </div>
    </aside>
  </body>
</html>
