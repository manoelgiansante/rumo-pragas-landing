---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import FactsBar from '../components/FactsBar.astro';
import Problem from '../components/Problem.astro';
import HowItWorks from '../components/HowItWorks.astro';
import PragasGallery from '../components/PragasGallery.astro';
import AIAgronomist from '../components/AIAgronomist.astro';
import WhoItsFor from '../components/WhoItsFor.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout includeHomeStructuredData>
  <Header />
  <main id="main-content" tabindex="-1">
    <Hero />
    <FactsBar />
    <Problem />
    <HowItWorks />
    <PragasGallery />
    <AIAgronomist />
    <WhoItsFor />
    <FAQ />
    <FinalCTA />
  </main>
  <Footer />
</BaseLayout>
